:root{ --primary:#0b5d4f; --secondary:#d6e2e0; --light:#edf3f3; }
*{box-sizing:border-box; margin:0; padding:0;}
body{font-family:Arial, sans-serif; background:var(--secondary); line-height:1.6; padding:10px;}

nav{display:flex; justify-content:space-between; align-items:center; background:white; border:2px solid #222; padding:12px 15px; position:sticky; top:0; z-index:10; border-radius:12px; margin-bottom:15px; flex-wrap:wrap;}
.logo{font-weight:900; font-size:18px;}
.nav-links{display:flex; flex-wrap:wrap; gap:10px;}
nav a{text-decoration:none; color:#222; font-weight:bold; font-size:12px;}
nav a:hover{color:var(--primary);}

.section{max-width:1000px; margin:15px auto; background:var(--light); border:2px solid #222; border-radius:16px; padding:25px; text-align:center;}
.home{display:flex; flex-direction:column; align-items:center; gap:15px;}
.home-text h1{font-size:32px; font-weight:900; line-height:1.1; margin-bottom:8px;}
.home-text h2{font-size:16px; font-weight:700; margin-bottom:10px;}
.home-text p{font-size:14px; color:#444; max-width:500px; margin:0 auto;}
.profile-pic{width:150px; height:150px;}
.profile-pic img{width:150px; height:150px; border-radius:50%; border:3px solid #222; object-fit:cover; display:block;}
.title{color:var(--primary); margin-bottom:10px; text-align:left;}
.btn{background:var(--primary); color:white; padding:8px 14px; border:2px solid #222; border-radius:8px; text-decoration:none; display:inline-block; margin-top:10px; margin-right:5px;}
.btn.outline{background:white; color:#222;}
.boxes{display:flex; gap:15px; flex-wrap:wrap; margin-top:15px; text-align:left;}
.box{flex:1; min-width:200px; background:white; border:2px solid #222; padding:15px; border-radius:2px 18px 2px 18px;}
form input, form textarea{width:100%; padding:10px; margin:8px 0; border:2px solid #222; border-radius:8px; text-align:left;}
form button{background:var(--primary); color:white; padding:10px 20px; border:2px solid #222; cursor:pointer; border-radius:8px;}

#about, #skills, #projects, #contact{text-align:left;}


